# Compose port publishing (not application settings).
MUX_PUBLISH_HOST=0.0.0.0
MUX_PUBLISH_PORT=8380

# Listener. Remove both TLS paths for local HTTP; public HTTP needs explicit opt-in.
MUX_SERVER_HOST=0.0.0.0
MUX_SERVER_PORT=8380
MUX_SERVER_TLS_CERT_FILE=./certs/fullchain.pem
MUX_SERVER_TLS_KEY_FILE=./certs/privkey.pem
MUX_SERVER_ALLOW_INSECURE_PUBLIC_HTTP=false
MUX_SERVER_ALLOW_UNAUTHENTICATED_PUBLIC_PROXY=false
MUX_SERVER_MAX_CONNECTIONS=1024
MUX_SERVER_MAX_CONNECTIONS_PER_IP=128
MUX_SERVER_MAX_HEADER_BYTES=65536
MUX_SERVER_HTTP2_MAX_CONCURRENT_STREAMS=0
MUX_SERVER_HTTP2_SEND_PING_TIMEOUT=1m
MUX_SERVER_HTTP2_PING_TIMEOUT=15s
MUX_SERVER_HTTP2_WRITE_BYTE_TIMEOUT=30s
MUX_SERVER_READ_HEADER_TIMEOUT=15s
MUX_SERVER_IDLE_TIMEOUT=2m
MUX_SERVER_SHUTDOWN_TIMEOUT=15s

# Client authentication.
MUX_AUTH_ENABLED=true
MUX_AUTH_USERNAME=<set-username>
MUX_AUTH_PASSWORD=<set-strong-password>

# Selection and timeouts. MUX_PROXY_TIMEOUT is in seconds.
MUX_PROXY_ALGORITHM=roundrobin
MUX_PROXY_TIMEOUT=30
MUX_PROXY_NETWORK=auto
MUX_PROXY_DIAL_TIMEOUT=10s
MUX_PROXY_DIAL_KEEP_ALIVE=30s
MUX_PROXY_TLS_HANDSHAKE_TIMEOUT=10s
MUX_PROXY_RESPONSE_HEADER_TIMEOUT=30s
MUX_PROXY_IDLE_CONN_TIMEOUT=90s
MUX_PROXY_EXPECT_CONTINUE_TIMEOUT=1s
MUX_PROXY_MAX_IDLE_CONNS=100
MUX_PROXY_MAX_IDLE_CONNS_PER_HOST=10
MUX_PROXY_MAX_CONNS_PER_HOST=0
MUX_PROXY_MAX_TUNNELS=256
MUX_PROXY_MAX_TUNNELS_PER_IP=128
MUX_PROXY_TUNNEL_IDLE_TIMEOUT=2m
MUX_PROXY_FAILOVER_COOLDOWN=30s

# All configured upstreams are listed from 1 to MUX_UPSTREAM_COUNT.
# Use http, https, socks4, or socks5 URLs. Keep credentials out of URLs.
MUX_UPSTREAM_COUNT=4

MUX_UPSTREAM_1_URL=http://proxy1.example.com:8080
MUX_UPSTREAM_1_AUTH_ENABLED=false
MUX_UPSTREAM_1_AUTH_USERNAME=
MUX_UPSTREAM_1_AUTH_PASSWORD=
MUX_UPSTREAM_1_TLS_CA_FILE=

MUX_UPSTREAM_2_URL=https://proxy2.example.com:8443
MUX_UPSTREAM_2_AUTH_ENABLED=true
MUX_UPSTREAM_2_AUTH_USERNAME=<upstream-username>
MUX_UPSTREAM_2_AUTH_PASSWORD=<upstream-password>
MUX_UPSTREAM_2_TLS_CA_FILE=

# SOCKS4 accepts USERID but no password. Hostname destinations use SOCKS4a.
MUX_UPSTREAM_3_URL=socks4://proxy3.example.com:1080
MUX_UPSTREAM_3_AUTH_ENABLED=true
MUX_UPSTREAM_3_AUTH_USERNAME=<upstream-username>
MUX_UPSTREAM_3_AUTH_PASSWORD=
MUX_UPSTREAM_3_TLS_CA_FILE=

# SOCKS5 supports username/password or no authentication.
MUX_UPSTREAM_4_URL=socks5://proxy4.example.com:1080
MUX_UPSTREAM_4_AUTH_ENABLED=true
MUX_UPSTREAM_4_AUTH_USERNAME=<upstream-username>
MUX_UPSTREAM_4_AUTH_PASSWORD=<upstream-password>
MUX_UPSTREAM_4_TLS_CA_FILE=
